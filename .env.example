# Local development only: Vite dev server proxy target for /api requests.
# Copy this file to .env.local and adjust.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3000

# Runtime API base URL used by the browser app.
# In POC behind CloudFront this should stay /api.
VITE_API_BASE_URL=/api

# Sign-in methods exposed on /login:
#   basic   - username/password (API AUTH_MODE=basic or both)
#   cognito - Cognito hosted UI only
#   both    - username/password + SSO when Cognito env vars are set (default)
VITE_AUTH_MODE=both

# Optional app base path for hosting under a sub-path.
# Keep "/" when hosted at CloudFront root.
VITE_PUBLIC_BASE_PATH=/

# Cognito hosted-UI configuration. All four VITE_COGNITO_* values are
# required to render the sign-in button on /login.
# VITE_COGNITO_DOMAIN=https://your-prefix.auth.us-east-1.amazoncognito.com
# VITE_COGNITO_CLIENT_ID=
# VITE_COGNITO_REDIRECT_URI=http://localhost:9000/auth/callback
# Logout MUST land on a public route (e.g. /login). Pointing this at "/" or
# any auth-gated path causes the router guard to immediately auto-redirect
# through the identity provider and silently re-grant a token, looking to the
# user as if logout did nothing.
# VITE_COGNITO_LOGOUT_URI=http://localhost:9000/login
# VITE_COGNITO_SCOPES=openid email profile
# Optional: skip the hosted-UI "choose IdP" page and go straight to one IdP.
# VITE_COGNITO_IDP_IDENTIFIER=Example-Employees

# Value of `custom:roles` (or `cognito:groups`) that grants admin in the SPA.
# Must match the Lambda's ADMIN_ROLE_CLAIM_VALUE env var. Defaults to "admin".
VITE_ADMIN_ROLE_CLAIM_VALUE=admin

# Value of `custom:roles` (or `cognito:groups`) that grants Applications-only
# management access in the SPA (the "app_editor" role). Must match the
# Lambda's APP_EDIT_ROLE_CLAIM_VALUE env var. Defaults to "app-edit".
VITE_APP_EDIT_ROLE_CLAIM_VALUE=app-edit
