# Deploy-time variables (used by `npm run deploy:poc`).
# Copy to .env.deploy.local and fill in your values.
POC_AWS_REGION=us-east-1
POC_AWS_PROFILE=<AWS_PROFILE>

# CloudFront + S3 hosting
POC_S3_BUCKET=<S3_BUCKET_NAME>
POC_CLOUDFRONT_DISTRIBUTION_ID=<CLOUDFRONT_DISTRIBUTION_ID>

# Cognito hosted UI (from your user pool)
VITE_COGNITO_DOMAIN=https://<COGNITO_DOMAIN>.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=<COGNITO_CLIENT_ID>
VITE_COGNITO_REDIRECT_URI=https://easycmdb.example.com/auth/callback
VITE_COGNITO_LOGOUT_URI=https://easycmdb.example.com/login
VITE_COGNITO_SCOPES=openid email profile
VITE_COGNITO_IDP_IDENTIFIER=Example-Employees
