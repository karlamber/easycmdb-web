# Build-time Vite variables (used by `npm run build:poc`).
VITE_API_BASE_URL=/api
VITE_PUBLIC_BASE_PATH=/

# Deploy-time variables (used by `npm run deploy:poc`).
# Use .env.deploy.poc for actual values; keep secrets out of git.
POC_AWS_REGION=us-east-1
POC_AWS_PROFILE=
POC_DEPLOY_BUCKET=
POC_S3_PREFIX=
# Set either distribution ID or CloudFront domain name.
POC_CLOUDFRONT_DISTRIBUTION_ID=
POC_CLOUDFRONT_DOMAIN_NAME=<CLOUDFRONT_DISTRIBUTION_ID>.cloudfront.net
POC_INVALIDATION_PATHS=/*
