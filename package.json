{
  "name": "easycmdb-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode local",
    "dev:sb": "vite --mode sb",
    "dev:dev": "vite --mode dev",
    "dev:tst": "vite --mode tst",
    "dev:prod": "vite --mode prod",
    "build": "npm run type-check && vite build",
    "build:poc": "npm run type-check && vite build --mode poc",
    "build:sb": "npm run type-check && vite build --mode sb",
    "build:dev": "npm run type-check && vite build --mode dev",
    "build:tst": "npm run type-check && vite build --mode tst",
    "build:prod": "npm run type-check && vite build --mode prod",
    "deploy:poc": "node ./scripts/deploy-poc.mjs",
    "preview": "vite preview",
    "type-check": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --write \"**/*.{js,ts,tsx,scss,css,html,md,json}\" --ignore-path .gitignore",
    "test": "vitest",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:ci": "vitest run --passWithNoTests",
    "test:unit:coverage": "vitest run --coverage --silent --passWithNoTests",
    "prepare": "husky install"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.8.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.8.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@tailwindcss/vite": "^4.1.12",
    "@trivago/prettier-plugin-sort-imports": "^5.2.0",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.4",
    "@vitest/ui": "^2.0.5",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "happy-dom": "^15.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.0.3",
    "prettier-plugin-merge": "^0.9.1",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-organize-imports": "^4.1.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1",
    "vite": "^6.2.6",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=24"
  }
}
